{
  "schema": 1,
  "id": "adding-machine",
  "name": "Adding Machine",
  "author": "Keytone",
  "description": "Heavy 1950s mechanical calculator. Enter cranks the motor and prints the total.",
  "volume": 1.0,
  "trim_silence": true,
  "random": {
    "pitch_cents": 20,
    "gain_db": 1.0
  },
  "defaults": {
    "down": [
      "key1.wav",
      "key2.wav",
      "key3.wav",
      "key4.wav"
    ]
  },
  "groups": {
    "enter": {
      "down": [
        "total.wav"
      ]
    },
    "space": {
      "down": [
        "space.wav"
      ]
    }
  },
  "keys": {}
}
