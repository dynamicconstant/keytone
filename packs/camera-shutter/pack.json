{
  "schema": 1,
  "id": "camera-shutter",
  "name": "Camera Shutter",
  "author": "Keytone",
  "description": "DSLR shutter on every key, a burst on Space, and the film winder on Enter.",
  "volume": 1.0,
  "trim_silence": true,
  "random": {
    "pitch_cents": 20,
    "gain_db": 1.0
  },
  "defaults": {
    "down": [
      "shutter1.wav",
      "shutter2.wav",
      "shutter3.wav",
      "shutter4.wav"
    ]
  },
  "groups": {
    "space": {
      "down": [
        "burst.wav"
      ]
    },
    "enter": {
      "down": [
        "winder.wav"
      ]
    }
  },
  "keys": {}
}
