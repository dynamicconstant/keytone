{
  "schema": 1,
  "id": "clicky",
  "name": "Clicky",
  "author": "Keytone",
  "description": "Crisp click-jacket switches with a sharp release.",
  "volume": 1.0,
  "trim_silence": true,
  "random": {
    "pitch_cents": 30,
    "gain_db": 1.5
  },
  "defaults": {
    "down": [
      "click1.wav",
      "click2.wav",
      "click3.wav",
      "click4.wav"
    ],
    "up": [
      "release1.wav",
      "release2.wav"
    ]
  },
  "groups": {
    "space": {
      "down": [
        "space.wav"
      ]
    },
    "enter": {
      "down": [
        "enter.wav"
      ]
    }
  },
  "keys": {}
}
